{
  "name": "telegram-tracker-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:goplus": "node scripts/check-goplus.mjs",
    "check:route": "node --disable-warning=ExperimentalWarning --import ./scripts/preload-optional-bindings.mjs --import tsx scripts/check-route.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts *.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts *.json .prettierrc.json",
    "start": "node --disable-warning=ExperimentalWarning --import ./scripts/preload-optional-bindings.mjs dist/main.js",
    "dev": "node --import ./scripts/preload-optional-bindings.mjs --import tsx src/main.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@pancakeswap/sdk": "5.9.3",
    "@pancakeswap/smart-router": "7.8.0",
    "@pancakeswap/swap-sdk-core": "1.6.1",
    "@pancakeswap/universal-router-sdk": "1.5.7",
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@uniswap/uniswapx-sdk": "^3.0.0",
    "@uniswap/universal-router-sdk": "^5.12.0",
    "bn.js": "5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.3",
    "grammy": "^1.38.3",
    "teleproto": "^1.232.0",
    "viem": "^2.38.5",
    "zod": "^4.1.12"
  },
  "overrides": {
    "ws@>=8 <9": "^8.22.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
