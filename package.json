{
  "name": "telegram-tracker-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.json .prettierrc.json",
    "format:check": "prettier --check src tests *.json .prettierrc.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@uniswap/uniswapx-sdk": "^3.0.0",
    "@uniswap/universal-router-sdk": "^5.12.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.3",
    "grammy": "^1.38.3",
    "teleproto": "^1.232.0",
    "viem": "^2.38.5",
    "zod": "^4.1.12"
  },
  "overrides": {
    "ws@>=8 <9": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
